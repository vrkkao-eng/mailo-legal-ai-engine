# Optional live research only. Offline demo, graph, validate and sparql need no keys.
# The CLI reads environment variables; it does not automatically load this file.
ANTHROPIC_API_KEY=
MAILO_MODEL=

# Optional local API configuration. CORS is disabled unless explicit origins are set.
MAILO_MAX_REQUEST_BYTES=1048576
MAILO_REQUEST_TIMEOUT_SECONDS=30
MAILO_CORS_ORIGINS=
